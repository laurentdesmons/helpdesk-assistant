# Copy to .env and fill in after `azd provision` (Phase 0.5). .env is gitignored.
# All variables use the HELPDESK_ prefix (see src/helpdesk/config.py).

# --- Foundry project (Phase 0.5) -------------------------------------------
# Responses endpoint of the Foundry project, e.g.
#   https://<account>.services.ai.azure.com/api/projects/<project>
HELPDESK_FOUNDRY_PROJECT_ENDPOINT=
# Project endpoint used by langchain-azure-ai / azure-ai-projects (often the same host)
HELPDESK_AZURE_AI_PROJECT_ENDPOINT=
# Application Insights connection string (shared by all three agents)
HELPDESK_APPLICATIONINSIGHTS_CONNECTION_STRING=

# --- Classifier: Claude Haiku 4.5 on Foundry (Phase 1) --------------------
# The sub-domain before ".services.ai.azure.com" of your Foundry resource
HELPDESK_ANTHROPIC_FOUNDRY_RESOURCE=
# Optional: API-key auth instead of DefaultAzureCredential
HELPDESK_ANTHROPIC_FOUNDRY_API_KEY=
HELPDESK_CLASSIFIER_MODEL=claude-haiku-4-5

# --- Resolver: GPT-5.4-mini on Foundry (Phase 3) -------------------------
HELPDESK_RESOLVER_MODEL=gpt-5.4-mini
HELPDESK_RESOLVER_MODEL_FALLBACK=gpt-5-mini

# --- Evaluation judge (Phase 3) — MUST NOT be a *mini* model --------------
HELPDESK_JUDGE_MODEL=claude-sonnet-5

# --- Azure AI Search (Phase 2) ------------------------------------------
HELPDESK_SEARCH_ENDPOINT=
HELPDESK_EMBEDDING_MODEL=text-embedding-3-large
HELPDESK_SUPPORT_INDEX=support-index
HELPDESK_HR_INDEX=hr-index

# --- Behaviour --------------------------------------------------------------
# local  = classifier & resolver run in-process (default for dev)
# remote = call the deployed Foundry agents
# fake   = deterministic stubs (tests)
HELPDESK_AGENT_MODE=local
# Optional per-agent overrides: local | remote | fake
# HELPDESK_CLASSIFIER_MODE=
# HELPDESK_RESOLVER_MODE=
HELPDESK_CONFIDENCE_THRESHOLD=0.6

# --- Escalation store ----------------------------------------------------
HELPDESK_ESCALATION_STORE=json
HELPDESK_ESCALATION_STORE_PATH=.local/escalations.json

HELPDESK_LOG_LEVEL=INFO
